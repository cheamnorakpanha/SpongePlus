{
	"schemaVersion": 1,
	"id": "sponge-plus",
	"version": "${version}",
	"name": "Sponge+",
	"description": "Enhances the vanilla sponge with configurable absorption radius and optional lava absorption while preserving vanilla gameplay.",
	"authors": [
		"Me!"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/spongeplus/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.cheam.spongeplus.SpongePlus"
		],
		"client": [
			"com.cheam.spongeplus.client.SpongeClient"
		]
	},
	"mixins": [
		"spongeplus.mixins.json",
		{
			"config": "spongeplus.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*"
	}
}